<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows + WinForms only because WebView2 needs a window to live
         in. No UI is ever shown to the user; see WebViewHost.cs. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Windows_Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- PlaceholderFrame reads bitmap rows directly; far faster than GetPixel. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SIPSorcery was removed: we decode WebRTC in WebView2, not in C#.
         See IMPLEMENTATION_PLAN.md section 2.1. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
